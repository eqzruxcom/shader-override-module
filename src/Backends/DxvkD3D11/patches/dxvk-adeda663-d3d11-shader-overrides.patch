diff --git a/src/d3d11/d3d11_shader_override.cpp b/src/d3d11/d3d11_shader_override.cpp
new file mode 100644
index 00000000..0ed8309e
--- /dev/null
+++ b/src/d3d11/d3d11_shader_override.cpp
@@ -0,0 +1,161 @@
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+
+#include "../util/log/log.h"
+#include "../util/util_string.h"
+
+#include "d3d11_shader_override.h"
+
+namespace dxvk {
+
+  namespace {
+
+    constexpr std::uintmax_t MaxReplacementSize = 64ull * 1024ull * 1024ull;
+    constexpr std::uintmax_t MaxReplacementCacheSize = 64ull * 1024ull * 1024ull;
+
+  }
+
+  D3D11ShaderOverride::D3D11ShaderOverride(std::string path)
+  : m_path(std::move(path)) { }
+
+
+  D3D11ShaderOverrideSource D3D11ShaderOverride::resolve(
+          VkShaderStageFlagBits stage,
+    const void*                 bytecode,
+          std::size_t           bytecodeLength) const {
+    D3D11ShaderOverrideSource result;
+
+    if (m_path.empty() || !bytecode || !bytecodeLength)
+      return result;
+
+    const char* suffix = getStageSuffix(stage);
+    if (!suffix)
+      return result;
+
+    result.originalHash = compute3DmigotoHash(bytecode, bytecodeLength);
+
+    std::ostringstream name;
+    name << std::hex << std::nouppercase << std::setfill('0')
+         << std::setw(16) << result.originalHash << "-" << suffix;
+    result.identity = name.str();
+    result.path = m_path / (result.identity + "_replace.bin");
+
+    auto invalidateCached = [&] {
+      std::lock_guard<std::mutex> lock(m_cacheMutex);
+      auto entry = m_cache.find(result.identity);
+
+      if (entry != m_cache.end()) {
+        m_cacheBytes -= entry->second.fileSize;
+        m_cache.erase(entry);
+      }
+    };
+
+    std::error_code error;
+    auto size = std::filesystem::file_size(result.path, error);
+
+    if (error || !size) {
+      invalidateCached();
+      return result;
+    }
+
+    if (size > MaxReplacementSize) {
+      invalidateCached();
+      Logger::warn(str::format("D3D11: Rejecting oversized shader replacement ", result.path.string()));
+      return result;
+    }
+
+    auto writeTime = std::filesystem::last_write_time(result.path, error);
+    if (error) {
+      invalidateCached();
+      return result;
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(m_cacheMutex);
+      auto entry = m_cache.find(result.identity);
+
+      if (entry != m_cache.end()
+       && entry->second.fileSize == size
+       && entry->second.writeTime == writeTime) {
+        result.replacement = entry->second.replacement;
+        return result;
+      }
+    }
+
+    auto bytes = std::make_shared<std::vector<std::uint8_t>>(static_cast<std::size_t>(size));
+
+    std::ifstream stream(result.path, std::ios::binary);
+    stream.read(reinterpret_cast<char*>(bytes->data()), static_cast<std::streamsize>(bytes->size()));
+
+    if (!stream) {
+      Logger::warn(str::format("D3D11: Failed to read shader replacement ", result.path.string()));
+      invalidateCached();
+      return result;
+    }
+
+    std::lock_guard<std::mutex> lock(m_cacheMutex);
+    auto publishSize = std::filesystem::file_size(result.path, error);
+    auto publishTime = std::filesystem::last_write_time(result.path, error);
+
+    if (error || publishSize != size || publishTime != writeTime) {
+      Logger::warn(str::format("D3D11: Shader replacement changed while reading ", result.path.string()));
+      return result;
+    }
+
+    auto current = m_cache.find(result.identity);
+    if (current != m_cache.end()
+     && current->second.fileSize == size
+     && current->second.writeTime == writeTime) {
+      result.replacement = current->second.replacement;
+      return result;
+    }
+
+    if (current != m_cache.end()) {
+      m_cacheBytes -= current->second.fileSize;
+      m_cache.erase(current);
+    }
+
+    while (m_cacheBytes + size > MaxReplacementCacheSize && !m_cache.empty()) {
+      auto victim = m_cache.begin();
+      m_cacheBytes -= victim->second.fileSize;
+      m_cache.erase(victim);
+    }
+
+    result.replacement = std::move(bytes);
+    m_cache.emplace(result.identity, CacheEntry { writeTime, size, result.replacement });
+    m_cacheBytes += size;
+    return result;
+  }
+
+
+  std::uint64_t D3D11ShaderOverride::compute3DmigotoHash(
+    const void*       bytecode,
+          std::size_t bytecodeLength) {
+    constexpr std::uint64_t Fnv64Prime = 0x100000001b3ULL;
+
+    std::uint64_t hash = 0u;
+    const auto* bytes = reinterpret_cast<const std::uint8_t*>(bytecode);
+
+    for (std::size_t i = 0u; i < bytecodeLength; i++) {
+      hash *= Fnv64Prime;
+      hash ^= bytes[i];
+    }
+
+    return hash;
+  }
+
+
+  const char* D3D11ShaderOverride::getStageSuffix(VkShaderStageFlagBits stage) {
+    switch (stage) {
+      case VK_SHADER_STAGE_VERTEX_BIT:                  return "vs";
+      case VK_SHADER_STAGE_TESSELLATION_CONTROL_BIT:    return "hs";
+      case VK_SHADER_STAGE_TESSELLATION_EVALUATION_BIT: return "ds";
+      case VK_SHADER_STAGE_GEOMETRY_BIT:                return "gs";
+      case VK_SHADER_STAGE_FRAGMENT_BIT:                return "ps";
+      case VK_SHADER_STAGE_COMPUTE_BIT:                 return "cs";
+      default:                                          return nullptr;
+    }
+  }
+
+}
diff --git a/src/d3d11/d3d11_shader_override.h b/src/d3d11/d3d11_shader_override.h
new file mode 100644
index 00000000..12404005
--- /dev/null
+++ b/src/d3d11/d3d11_shader_override.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <vulkan/vulkan.h>
+
+namespace dxvk {
+
+  struct D3D11ShaderOverrideSource {
+    std::uint64_t originalHash = 0u;
+    std::string identity;
+    std::filesystem::path path;
+    std::shared_ptr<const std::vector<std::uint8_t>> replacement;
+
+    explicit operator bool () const {
+      return replacement && !replacement->empty();
+    }
+  };
+
+  class D3D11ShaderOverride {
+  public:
+    explicit D3D11ShaderOverride(std::string path);
+
+    D3D11ShaderOverrideSource resolve(
+            VkShaderStageFlagBits stage,
+      const void*                 bytecode,
+            std::size_t           bytecodeLength) const;
+
+  private:
+    struct CacheEntry {
+      std::filesystem::file_time_type writeTime;
+      std::uintmax_t fileSize = 0u;
+      std::shared_ptr<const std::vector<std::uint8_t>> replacement;
+    };
+
+    std::filesystem::path m_path;
+    mutable std::mutex m_cacheMutex;
+    mutable std::unordered_map<std::string, CacheEntry> m_cache;
+    mutable std::uintmax_t m_cacheBytes = 0u;
+
+    static std::uint64_t compute3DmigotoHash(
+      const void*       bytecode,
+            std::size_t bytecodeLength);
+
+    static const char* getStageSuffix(VkShaderStageFlagBits stage);
+  };
+
+}
