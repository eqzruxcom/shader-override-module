+  HRESULT D3D11Device::CreateShaderModuleWithOverride(
+          D3D11CommonShader*      pShaderModule,
+          ID3D11ClassLinkage*     pLinkage,
+          VkShaderStageFlagBits   Stage,
+    const void*                   pShaderBytecode,
+          size_t                  BytecodeLength,
+    const DxvkIrShaderCreateInfo& ModuleInfo,
+    const D3D11_SO_DECLARATION_ENTRY* pSODeclaration,
+          UINT                    NumEntries,
+    const UINT*                   pBufferStrides,
+          UINT                    NumStrides,
+          UINT                    RasterizedStream) {
+    auto computeKey = [&] (const void* bytes, size_t length) {
+      return ComputeShaderKey(Stage, bytes, length,
+        pSODeclaration, NumEntries, pBufferStrides, NumStrides, RasterizedStream);
+    };
+
+    auto replacement = m_shaderOverride.resolve(Stage, pShaderBytecode, BytecodeLength);
+
+    if (!replacement) {
+      return CreateShaderModule(pShaderModule, pLinkage,
+        computeKey(pShaderBytecode, BytecodeLength),
+        pShaderBytecode, BytecodeLength, ModuleInfo);
+    }
+
+    D3D11CommonShader originalModule;
+    HRESULT originalHr = CreateShaderModule(&originalModule, pLinkage,
+      computeKey(pShaderBytecode, BytecodeLength),
+      pShaderBytecode, BytecodeLength, ModuleInfo);
+
+    if (FAILED(originalHr))
+      return originalHr;
+
+    auto originalContainer = dxbc_spv::dxbc::Container(pShaderBytecode, BytecodeLength);
+    auto replacementContainer = dxbc_spv::dxbc::Container(
+      replacement.replacement->data(), replacement.replacement->size());
+
+    auto sameChunk = [] (dxbc_spv::util::ByteReader a, dxbc_spv::util::ByteReader b) {
+      return a.getSize() == b.getSize()
+          && (!a.getSize() || !std::memcmp(a.getData(0u), b.getData(0u), a.getSize()));
+    };
+
+    bool signaturesMatch = replacementContainer
+      && sameChunk(originalContainer.getInputSignatureChunk(), replacementContainer.getInputSignatureChunk())
+      && sameChunk(originalContainer.getOutputSignatureChunk(), replacementContainer.getOutputSignatureChunk())
+      && sameChunk(originalContainer.getPatchConstantSignatureChunk(), replacementContainer.getPatchConstantSignatureChunk());
+
+    if (!signaturesMatch) {
+      Logger::warn(str::format("D3D11: Rejecting shader replacement ", replacement.identity,
+        ": input/output signature mismatch"));
+      *pShaderModule = std::move(originalModule);
+      return S_OK;
+    }
+
+    auto collectExternalDeclarations = [] (
+      const dxbc_spv::dxbc::Container& container,
+            std::vector<std::vector<unsigned char>>& declarations) {
+      dxbc_spv::dxbc::Parser parser(container.getCodeChunk());
+      auto shaderInfo = parser.getShaderInfo();
+
+      while (parser) {
+        auto op = parser.parseInstruction();
+
+        if (!op)
+          return false;
+
+        bool isExternalDeclaration = false;
+
+        switch (op.getOpToken().getOpCode()) {
+          case dxbc_spv::dxbc::OpCode::eDclSampler:
+          case dxbc_spv::dxbc::OpCode::eDclConstantBuffer:
+          case dxbc_spv::dxbc::OpCode::eDclResource:
+          case dxbc_spv::dxbc::OpCode::eDclResourceRaw:
+          case dxbc_spv::dxbc::OpCode::eDclResourceStructured:
+          case dxbc_spv::dxbc::OpCode::eDclUavTyped:
+          case dxbc_spv::dxbc::OpCode::eDclUavRaw:
+          case dxbc_spv::dxbc::OpCode::eDclUavStructured:
+          case dxbc_spv::dxbc::OpCode::eDclThreadGroup:
+            isExternalDeclaration = true;
+            break;
+
+          default:
+            break;
+        }
+
+        if (isExternalDeclaration) {
+          dxbc_spv::util::ByteWriter writer;
+
+          if (!op.write(writer, shaderInfo))
+            return false;
+
+          declarations.push_back(std::move(writer).extract());
+        }
+      }
+
+      std::sort(declarations.begin(), declarations.end());
+      return true;
+    };
+
+    std::vector<std::vector<unsigned char>> originalDeclarations;
+    std::vector<std::vector<unsigned char>> replacementDeclarations;
+    bool declarationsMatch = collectExternalDeclarations(originalContainer, originalDeclarations)
+      && collectExternalDeclarations(replacementContainer, replacementDeclarations)
+      && originalDeclarations == replacementDeclarations;
+
+    if (!declarationsMatch) {
+      Logger::warn(str::format("D3D11: Rejecting shader replacement ", replacement.identity,
+        ": resource or thread-group declaration mismatch"));
+      *pShaderModule = std::move(originalModule);
+      return S_OK;
+    }
+
+    D3D11CommonShader replacementModule;
+    HRESULT replacementHr = CreateShaderModule(&replacementModule, pLinkage,
+      computeKey(replacement.replacement->data(), replacement.replacement->size()),
+      replacement.replacement->data(), replacement.replacement->size(), ModuleInfo);
+
+    if (FAILED(replacementHr)) {
+      Logger::warn(str::format("D3D11: Rejecting shader replacement ", replacement.identity,
+        ": invalid replacement DXBC"));
+      *pShaderModule = std::move(originalModule);
+      return S_OK;
+    }
+
+    auto a = originalModule.GetBindingMask();
+    auto b = replacementModule.GetBindingMask();
+    bool bindingsMatch = a.cbvMask == b.cbvMask
+      && a.samplerMask == b.samplerMask
+      && a.uavMask == b.uavMask
+      && a.srvMask == b.srvMask;
+
+    if (!bindingsMatch) {
+      Logger::warn(str::format("D3D11: Rejecting shader replacement ", replacement.identity,
+        ": accessed resource-register mismatch"));
+      *pShaderModule = std::move(originalModule);
+      return S_OK;
+    }
+
+    Logger::info(str::format("D3D11: Loaded shader replacement ", replacement.identity,
+      " from ", replacement.path.string()));
+    *pShaderModule = std::move(replacementModule);
+    return S_OK;
+  }
+
+
   DxvkShaderHash D3D11Device::ComputeShaderKey(
           VkShaderStageFlagBits   Stage,
     const void*                   pShaderBytecode,
