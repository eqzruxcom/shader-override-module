{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.rebirth-effects.invalid/ue4-pass-descriptor.schema.json",
  "title": "Independent UE4 DXBC semantic pass descriptor",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "family",
    "displayName",
    "stages",
    "shaderModels",
    "semanticSignature"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "family": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["vs", "ps", "cs", "hs", "ds", "gs"] }
    },
    "shaderModels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(vs|ps|cs|hs|ds|gs)_5_0$" }
    },
    "hashFastPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter", "hash"],
        "properties": {
          "adapter": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "semanticSignature": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "pattern", "minCount", "meaning"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
              "pattern": { "type": "string", "minLength": 1 },
              "minCount": { "type": "integer", "minimum": 0 },
              "maxCount": { "type": ["integer", "null"], "minimum": 0 },
              "meaning": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runtimeContract": { "type": "object" },
    "sourceEvidence": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
